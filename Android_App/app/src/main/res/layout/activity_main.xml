<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6F8FC" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PriceMatcher" android:textSize="30sp" android:textStyle="bold" android:textColor="#172033"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Seller Hub Remote Control" android:textColor="#667085" android:layout_marginBottom="14dp"/>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <Spinner android:id="@+id/laptopSpinner" android:layout_width="match_parent" android:layout_height="50dp"/>
                <TextView android:id="@+id/connectionText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No laptop selected" android:textStyle="bold" android:textSize="17sp" android:textColor="#172033" android:layout_marginTop="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/addLaptopButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add / Edit"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/removeLaptopButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Remove"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT CYCLE" android:textStyle="bold" android:textColor="#667085" android:layout_marginTop="20dp"/>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="true">
            <TextView android:id="@+id/cycleText" style="@style/StatBox" android:text="Cycle\n0"/>
            <TextView android:id="@+id/pageText" style="@style/StatBox" android:text="Page\n0"/>
            <TextView android:id="@+id/checkedText" style="@style/StatBox" android:text="Checked\n0"/>
            <TextView android:id="@+id/updatedText" style="@style/StatBox" android:text="Updated\n0"/>
            <TextView android:id="@+id/skippedText" style="@style/StatBox" android:text="Skipped\n0"/>
            <TextView android:id="@+id/errorsText" style="@style/StatBox" android:text="Errors\n0"/>
        </GridLayout>

        <TextView android:id="@+id/currentSkuText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Current SKU: —" android:textColor="#172033" android:textStyle="bold" android:padding="14dp" android:background="#FFFFFF" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/lastActionText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Last action: —" android:textColor="#667085" android:padding="14dp" android:background="#FFFFFF"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/startButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Start"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/pauseButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Pause"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/resumeButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="Resume"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/stopButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Stop"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/restartButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restart Bot" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECENT ACTIVITY" android:textStyle="bold" android:textColor="#667085" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/logsText" android:layout_width="match_parent" android:layout_height="260dp" android:background="#111827" android:textColor="#E5E7EB" android:textSize="12sp" android:fontFamily="monospace" android:padding="12dp" android:text="No logs yet." android:gravity="top" android:scrollbars="vertical"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
